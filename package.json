{
  "name": "vue-css-module-helper",
  "displayName": "vue-css-module-helper",
  "description": "这是一个vue文件的css module helper",
  "version": "0.0.7",
  "publisher": "tanyueran",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:vue"
  ],
  "icon": "./images/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Vue CSS Module Helper",
      "properties": {
        "vueCssModuleHelper.alias": {
          "type": "object",
          "default": {},
          "markdownDescription": "自定义路径别名映射，优先级高于 tsconfig/jsconfig 的 `compilerOptions.paths`。键为别名（如 `@`、`~@`），值为相对工作区根目录的路径（可为字符串或字符串数组）。\n\n示例：\n```json\n{\n  \"@\": \"src\",\n  \"~\": [\"src\", \"packages\"]\n}\n```",
          "additionalProperties": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "vscode-pkg": "npx vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanyueran/vue-outer-module-style-class-helper"
  }
}
